                  "description": "(Required) Start timestamp in unix timestamp in millseconds."
                },
                {
                  "disabled": false,
                  "key": "endTimestamp",
                  "value": "<long>",
                  "description": "End timestamp in unix timestamp in millseconds. If not specified, it assumes to be current time."
                },
