          "name": "Symphony Get a list of  actions performed by a privileged account acting as privileged user given a period of time.",
          "request": {
            "name": "Symphony Get a list of  actions performed by a privileged account acting as privileged user given a period of time.",
            "description": {
              "content": "Get a list of actions performed by a privileged account acting as privileged user given a period of time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "audittrail",
                "privilegeduser"
              ],
              "host": [
