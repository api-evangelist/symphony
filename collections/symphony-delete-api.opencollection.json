                "name": "sessionToken",
                "value": ""
              },
              {
                "name": "keyManagerToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path",
                "description": "Unique dictionary identifier."
              }
            ]
