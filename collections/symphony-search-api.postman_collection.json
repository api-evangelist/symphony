        {
          "id": "bdadabd3-a7ef-4761-9b89-751ea7ecb5b4",
          "name": "Search Messages",
          "request": {
            "name": "Search Messages",
            "description": {
              "content": "Search messages according to the specified criteria. The \"query\" parameter takes a search query defined as\n\"field:value\" pairs combined by the operator \"AND\" (e.g. \"text:foo AND autor:bar\"). Supported fields are\n (case-insensitive): \"text\", \"author\", \"hashtag\", \"cashtag\", \"mention\", \"signal\", \"fromDate\", \"toDate\",\n \"streamId\", \"streamType\".\n \"text\" search requires a \"streamId\" to be specified.\n \"streamType\" accepts one of the following values: \"chat\" (IMs and MIMs), \"im\", \"mim\", \"chatroom\", \"post\".\n \"signal\" queries can only be combined with \"fromDate\", \"toDate\", \"skip\" and \"limit\" parameters.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "message",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) The search query. See above for the query syntax."
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "No. of results to skip."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Max no. of results to return. If no value is provided, 50 is the default."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Describes where content should be searched for that query.\nIt can exclusively apply to Symphony content or to one Connector.\n"
                },
                {
                  "disabled": false,
                  "key": "sortDir",
                  "value": "<string>",
                  "description": "Messages sort direction : ASC or DESC (default to DESC)\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Session authentication token.",
                "key": "sessionToken",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Key Manager authentication token.",
