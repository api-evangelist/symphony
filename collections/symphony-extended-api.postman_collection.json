          "name": "Checks Health Status of Services and Users",
          "request": {
            "name": "Checks Health Status of Services and Users",
            "description": {
              "content": "_Available on Agent 2.57.0 and above._\n\nReturns the connectivity status of the Agent services (**pod**, **key manager** and **datafeed**) as well as users\nconnectivity (**agentservice** and **ceservice**).\n\nThe global status will be set to `DOWN` if at least one of the sub-status is also `DOWN`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "health",
                "extended"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
