        {
          "id": "ba30e04a-1ffe-40de-889a-b0c9e1b62b3a",
          "name": "Read List of Real Time Messages / Events Stream (\"datafeed\")",
          "request": {
            "name": "Read List of Real Time Messages / Events Stream (\"datafeed\")",
            "description": {
              "content": "_Available on Agent 2.57.0 and above._\n\nThe datafeed provides messages and events from all conversations that the user\nis in. The types of events surfaced in the datafeed can be found in the [Real Time Events](./docs/real-time-events.md) list.\n\nReturns the list of the datafeeds for the user.\nAny datafeed ID of the list can then be used as input to the Read Messages/Events Stream v4 endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v5",
                "datafeeds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "A unique identifier to ensure uniqueness of the datafeed. Used to restrict search."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Session authentication token.",
                "key": "sessionToken",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Key Manager authentication token.",
                "key": "keyManagerToken",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
